# ==============================================================================
# VIDLYTE HIGH-PERFORMANCE HLS GATEWAY & EMBED ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` for local testing or enter these variables in your
# cloud deployment platform dashboard (Render, Koyeb, Railway, Docker, VPS).

# ------------------------------------------------------------------------------
# 1. CORE NETWORKING & SERVICE PORTS
# ------------------------------------------------------------------------------
# The primary port for the VidLyte Core Hub (Landing portal, Admin portal, API, HLS gateway)
PORT=8080

# Environment mode: 'development' or 'production'
# In production, GATEWAY_HMAC_SECRET and VIDLYTE_ADMIN_SECRET must be securely set.
ENV=production

# Structured log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Optional decoupled player edge port (e.g. 6789).
# Set to 'none' on single-port container platforms (like Render or Koyeb free tier),
# or specify a port like 6789 to run a dedicated isolated player origin.
PLAYER_PORT=none

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret password / passphrase to unlock the hidden admin control room at `/admin-login-i`.
# Must be at least 32 characters or random 64-char hex string in production.
# Generate via: openssl rand -hex 32
VIDLYTE_ADMIN_SECRET=c9b2f67a840e43d79013ef15b88ad3f1c9b2f67a840e43d79013ef15b88ad3f1

# Cryptographic HMAC-SHA256 secret for signing all internal M3U8 proxy URLs and .ts chunks.
# Prevents unauthorized scraping, leeching, and hotlinking.
# Generate via: openssl rand -hex 32
STREAM_SECRET=a84f32c9e71b4028bc64d1872199acbf5307b22d10f92b774618e7d23a49f821

# Master gateway HMAC secret for timed session playback tokens (/v1/playback-sessions).
# Can be a single secret or comma-separated keyID:secret pairs for zero-downtime key rotation.
GATEWAY_HMAC_SECRET=e7d23a49f821a84f32c9e71b4028bc64d1872199acbf5307b22d10f92b774618
GATEWAY_HMAC_KEY_ID=v1
GATEWAY_TOKEN_TTL=4h

# ------------------------------------------------------------------------------
# 3. UPSTREAM & SECURITY CONTROLS
# ------------------------------------------------------------------------------
# Comma-separated whitelist of allowed upstream hostnames (SSRF prevention).
GATEWAY_UPSTREAM_HOSTS=img.animecurx.tech,sacdn.hakunaymatata.com,bcdn.hakunaymatata.com,embed.vidrift.net,mb.vidrift.net,api.framextv.xyz,api.framextv.cc,api.framextv.tech,framextv.cc,framextv.xyz,api.wing.st,cinejoy.pk,rumble.com,hugh.cdn.rumble.cloud,res.cloudinary.com,www.blogger.com,asianflix.one,api.themoviedb.org,127.0.0.1,localhost,cache.vdrk.site,vdrk.site,workers.dev

# Timeout for upstream manifest and chunk fetches
GATEWAY_UPSTREAM_TIMEOUT=12s
GATEWAY_UPSTREAM_MAX_CONNS=150

# Client IP binding for session playback tokens (set to false if using aggressive mobile carriers with dynamic IP pools)
GATEWAY_BIND_CLIENT_IP=false

# Token-bucket rate limiter settings
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_BURST=100
GATEWAY_RATE_LIMIT_RATE=30.0

# ------------------------------------------------------------------------------
# 4. OPTIONAL CACHING & METADATA
# ------------------------------------------------------------------------------
# High-speed disk cache for frequently requested HLS video chunks (.ts / .m4s)
GATEWAY_CACHE_ENABLED=false
GATEWAY_CACHE_DIR=./scratch/hls_cache
GATEWAY_CACHE_MAX_MB=500
GATEWAY_CACHE_TTL=1h

# TheMovieDatabase (TMDB) API Key for automatic poster and title enrichment
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED UPSTASH REDIS SWARM (100% FREE TIER CLUSTER)
# ------------------------------------------------------------------------------
# To enable multi-tier distributed caching across 1 to N free Upstash databases,
# supply comma-separated REST URLs and REST tokens.
# The system automatically applies Rendezvous (HRW) consistent hashing across them.
# Example:
# UPSTASH_REDIS_REST_URLS=https://db1.upstash.io,https://db2.upstash.io
# UPSTASH_REDIS_REST_TOKENS=AXxxxxxx1,AXxxxxxx2
UPSTASH_REDIS_REST_URLS=
UPSTASH_REDIS_REST_TOKENS=

